#include <windows.h>
#include "../src/resource.h"
#include "version.h"

IDI_APP ICON "hyperlink.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "host.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HL_VER_MAJOR, HL_VER_MINOR, HL_VER_PATCH, 0
PRODUCTVERSION HL_VER_MAJOR, HL_VER_MINOR, HL_VER_PATCH, 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Hyperlink Host"
            VALUE "ProductName", "Hyperlink"
            VALUE "FileVersion", HL_VER_STRING
            VALUE "ProductVersion", HL_VER_STRING
            VALUE "OriginalFilename", "HyperlinkHost.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
